    },
    {
      "id": "sources.physical.point.1",
      "text": "150–300 min/settimana di attività aerobica di intensità moderata oppure 75–150 min/settimana di attività aerobica intensa.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "3a5db32328af91158c2e36e07a1d8f4d8744f13c4bfb8e3a2fc8b2efcc4317f2"
    },
    {
      "id": "sources.physical.point.2",
      "text": "Attività di rafforzamento muscolare almeno 2 giorni alla settimana.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5cf5c7f8f721ec807fa87659483f315dd10142c7ef96432ae26a0b0cd817cb03"
    },
    {
      "id": "sources.physical.point.3",
      "text": "Ridurre il tempo trascorso seduti: ogni movimento conta.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "dee34785f6f7e547939a709a0906e6583962c8cb33c0204500f1f2a84594b4b5"
    },
    {
      "id": "sources.physical.point.4",
      "text": "Riduce il rischio di malattie cardiovascolari, diabete di tipo 2, alcuni tumori e cadute; migliora la salute mentale, il sonno e la composizione corporea.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "87cecd5ccb1b8da14bde678cbc5108c6ab08c7eb46935d7452c7caa7e1ab7cf5"
    },
