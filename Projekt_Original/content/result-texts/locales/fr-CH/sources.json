      "sourceContractHash": "a8e955a0e1dcff27f1022173b5da2698e093b2c01d2aa99952b620519443a455"
    },
    {
      "id": "sources.strength.point.3",
      "text": "L’équilibre sur une jambe, les pompes et la chaise contre un mur ne reflètent que certains aspects des capacités physiques ; ces exercices ne sont pas des tests du risque individuel de maladie.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fd95bfaf6950c0431f03f049aae64cb39a2a1f945831e020fb75fb605568b438"
    },
    {
      "id": "sources.strength.point.4",
      "text": "À partir de 18 ans, une orientation harmonisée pour l’entraînement est utilisée pour la chaise bilatérale contre un mur ; il ne s’agit ni d’une norme clinique ni d’un seuil diagnostique. Un test maximal peut fortement augmenter la tension artérielle de manière aiguë.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
