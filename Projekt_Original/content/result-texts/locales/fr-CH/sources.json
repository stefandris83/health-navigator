    {
      "id": "sources.physical.point.1",
      "text": "150–300 min/semaine d’activité d’endurance modérée ou 75–150 min/semaine d’activité d’endurance intense.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "88db9ed813a3da89bb81eb7c6840e01292f2f0c900917d0ee84e121389cd982d"
    },
    {
      "id": "sources.physical.point.2",
      "text": "Renforcement musculaire au moins 2 jours/semaine.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4b7006d07a0cb53b9b8d9dab80ef035ce05558311c20cf44db80eafb5ecd9528"
    },
    {
      "id": "sources.physical.point.3",
      "text": "Réduire le temps passé assis : chaque mouvement compte.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "c9292d54946bb1c684d8ed0ef48ad61fb7345f87b518da9aa545375506b9b2ad"
    },
    {
      "id": "sources.physical.point.4",
      "text": "Réduit le risque de maladies cardiovasculaires, de diabète de type 2, de certains cancers et de chutes ; améliore la santé mentale, le sommeil et la composition corporelle.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fcc4ed35e1d56096661b18b34cc309455bce36f93acaac25a44f6b15e93df6cd"
    },
