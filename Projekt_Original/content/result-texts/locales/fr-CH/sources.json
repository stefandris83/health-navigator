    {
      "id": "sources.blood_pressure.title",
      "text": "Tension artérielle et prévention cardiovasculaire",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5ce8d1a6bea11a8592c93ca3fb57cfaafd5e622dc2bbf8759e7bc93e69a0b94f"
    },
    {
      "id": "sources.blood_pressure.reference",
      "text": "OMS – Hypertension",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4f17f4aca2d5987ad333cd22d01255e1b39b6176a5999f31c8a7d816b7f08883"
    },
    {
      "id": "sources.blood_pressure.point.1",
      "text": "Hypertension à partir de 140/90 mmHg (mesurée sur deux jours).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e2d066f6957ad49dd6080b0afe1c0c154f2c1593d05df11db824f0184de324ac"
    },
    {
      "id": "sources.blood_pressure.point.2",
      "text": "Valeurs très élevées (env. 180/120 mmHg) → contrôle médical rapide.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fc91aeb8844323a71e04f248aa8bcd511de071ed088a452d27dcc6576dd896dd"
    },
    {
      "id": "sources.blood_pressure.point.3",
      "text": "Valeur cible souvent inférieure à 130/80 mmHg en cas de risque accru, sinon inférieure à 140/90.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a42cae2b4d270ef4188d808325ba0505a7f3a20891267a22b9c0e1e2a62f103f"
    },
    {
      "id": "sources.blood_pressure.point.4",
      "text": "Le mode de vie peut abaisser la tension artérielle ; alcool : au maximum 1 verre/jour pour les femmes et 2 pour les hommes.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "f0898f65a1a64856e415b6460f593752c347a05645402129547051d8e675cb23"
    },
