    {
      "id": "sources.strength.link_wall_sit",
      "text": "Wall-sit safety",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "01ba14a3135b3b57fdd4c1b7cedadbbb0c04e610466aa355fc32a6327aab3836"
    },
    {
      "id": "sources.strength.point.1",
      "text": "Muscle strength and physical function are important building blocks for resilience and independence.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "8581a33457a75641c53b4cf0cb9cf48a7a7c2d5eb771ecb078a216cd7787f526"
    },
    {
      "id": "sources.strength.point.2",
      "text": "You can also start with bodyweight exercises.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "614e28e04cf6848b92db258a0d530dd42d77089f17ce907b85848c5781229615"
    },
    {
      "id": "sources.strength.point.3",
      "text": "The single-leg stance, push-up and wall-sit tests each show only part of physical performance; they are not tests of your personal disease risk.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4582d8e3a4ac95a48d8403157054e3b44ba161d8ef0d795710f00376116f0d51"
    },
    {
      "id": "sources.strength.point.4",
      "text": "From age 18, a harmonised training guide is used for the bilateral wall sit; it is not a clinical norm or diagnostic threshold. A maximal test can cause a marked acute rise in blood pressure.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "bd5b964e60dfdce254d2614580088373a27894eacaa154f9deedb65536641d88"
    },
    {
      "id": "sources.card.8.number",
