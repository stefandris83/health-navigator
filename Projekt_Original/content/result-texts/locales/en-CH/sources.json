    {
      "id": "sources.scoring.title",
      "text": "How the scoring works",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e8f7aedcdabecbfb43b595a29db9b0c23cdde6b53fce65682137dbc2500508a4"
    },
    {
      "id": "sources.scoring.point.1",
      "text": "Each dimension receives a score from 0–100 (the weighted average of answered items).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "cf35321f407340dbd3b723b06bec091a1e675121b17a6284e0a16e3e6b018b27"
    },
    {
      "id": "sources.scoring.point.2",
      "text": "Optional short fitness tests complement the relevant fitness sub-area. The medically approved allocation remains unchanged: push-ups and wall sits together form the test half of muscular fitness; the single-leg stance forms the test half of balance/mobility. Women and men use the same standard push-up from the toes. Values for men up to age 69 come from a direct reference. For women, ages 18–24 are based on a small direct study and ages 25–65 on practical guidance; the older age bands up to 94 are modelled. Values without direct validation, as well as the wall-sit rating, are training guidance rather than clinical norms or diagnostic thresholds.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "ea35c5de6331c709a183e962b6a3c4ba21e42b9c36c202dc71229f057d87cf6b"
    },
    {
      "id": "sources.scoring.point.3",
      "text": "Status levels: 80–100 Strong, 60–79 Solid foundation, 40–59 Room for improvement, 0–39 Needs attention.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a704e92809b724414c50819a4c79d107e4202e0f1eb18db6ee7a9da12824d9a6"
    },
    {
      "id": "sources.scoring.point.4",
      "text": "Risk signals are separated into lifestyle potential and the need for medical assessment.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "1541f4c67d20da904c5e8e282dd7c4e3520f4c0e10a07f552d6899e5427051f8"
    },
    {
      "id": "sources.scoring.point.5",
      "text": "Strengths, areas for action and the top 3 steps are derived from the same answer-based levers (including cross-dimensional risk patterns such as cardiovascular patterns); critical signals always take priority.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "6e3d769131330cde97096ce365c7d3fe2b33184fabc9108cb2f730dac41c088a"
    },
    {
      "id": "sources.review_disclaimer",
      "text": "Before the product is used in practice, Helsana medical professionals should complete a final review and approval of the specialist content and reference values.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "f69bbe5530b24430d0c1c385465d83431764a08012017b0323103dad9e163e5a"
    }
