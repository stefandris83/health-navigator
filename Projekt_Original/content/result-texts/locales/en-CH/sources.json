      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5cf13e96c0bda66ce8dfa7fc80ae0d3a8f9bbce75b0f59d88cf4bf3dd76f268d"
    },
    {
      "id": "sources.sleep.title",
      "text": "Sleep & recovery",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "96b21c5ede806d7f3002d136233d3c5a6b38330b683c6bdf6eb9c8943795952b"
    },
    {
      "id": "sources.sleep.reference",
      "text": "CDC – About Sleep",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "811f42c1acef44bde82a4a77dd0d60493d391a69d4256e6b835396e851899a1a"
    },
    {
      "id": "sources.link.cdc",
      "text": "cdc.gov",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4702bc2b19fd4b280c446d01c650193cb5304c01748afc410b5ab26acf3efd05"
    },
    {
      "id": "sources.sleep.point.1",
      "text": "Adults: at least 7 hours (a guide of 7–9 hours).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4951036a9d30555bd1ef8ab9642ace4ec504d983242370d935c4527f7f69517e"
    },
    {
      "id": "sources.sleep.point.2",
      "text": "Sleep hygiene: keep regular times, make the room cool/dark/quiet, and switch off screens around 30 minutes beforehand.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "21bbc69028d00fddd76f0588bba972908cb544a0264653351515dca591833942"
    },
    {
      "id": "sources.sleep.point.3",
      "text": "Seek medical advice for persistent problems, snoring or pauses in breathing.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "cbbde1d39aec21e7af05d9dfc0a9172ae80fd36adedf0dc907d4b72ba3097648"
    },
    {
      "id": "sources.card.9.number",
      "text": "9",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5ed161ca5bd28b968565d8dfef2bb37e770500a68bd74d207180bc5c26338ab6"
    },
    {
      "id": "sources.mental.title",
      "text": "Mental health, stress & social resources",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "ca96125b4f37b05df9599732e717fb36e1c7d9fca2e04ec4c7b60844d184c23e"
    },
    {
      "id": "sources.mental.reference",
      "text": "WHO on mental health · evidence on social connection",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "448c6b1cfbae153bc3f264a9cc465260e345e0b9e472186603cf0fba2d340167"
    },
    {
      "id": "sources.mental.point.1",
      "text": "Chronic stress affects sleep, blood pressure, metabolism and mood.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "f10fa2d829e158ea8a3caf11508b85caaad129f1b3cc9e0ca2f48fbd6c4a39d8"
    },
    {
      "id": "sources.mental.point.2",
      "text": "Social connection is protective; loneliness is a risk factor.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "2801506764b1a2d216d0a47634be00087f7f33a3c352b210a3eb98fc8f5aa322"
    },
    {
      "id": "sources.mental.point.3",
      "text": "English-language emotional support in Switzerland: Heart2Heart on 0800 143 000, daily from 6 to 11 p.m.; emergency services on 144.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "3a988acffcd69a1b027ecc4c1d80d3aa117ee061053ea26350fe9eb2cf881e86"
    },
    {
      "id": "sources.card.10.number",
      "text": "10",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "996130cf302d4b82fc2adda8fd5ae83e76a5de963ba0b25a01b091975b10f068"
    },
    {
      "id": "sources.smoking.title",
      "text": "Smoking / nicotine",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "32b6141f2f89ae6886cab6be0e9939e9c2b837074053761b9b77543a5a6d8064"
    },
    {
      "id": "sources.smoking.reference",
      "text": "WHO – Cardiovascular diseases & hypertension",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "6b07755385d75f1c6bc91cf87e6f4ab0422289523e1f55f6d70c713c9d65c625"
    },
    {
      "id": "sources.smoking.point.1",
      "text": "Tobacco/nicotine is a major modifiable risk factor.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e5e0c4a6fbdd5bbb3b0abf4041e6907500d455642f1061fbe7ab2ecda2a74a0e"
    },
    {
      "id": "sources.smoking.point.2",
      "text": "Stopping smoking reduces cardiovascular risk within a short time.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "b5aac21710a8363faa99df48f99c2ba73dee787f34e50210cd07f8f5059334e5"
    },
    {
      "id": "sources.scoring.title",
      "text": "How the scoring works",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a7fb05056f9e255ed6ca1bc54b4fb94a5285c0e7339eed4490ba19c87cfeb9d3"
    },
    {
      "id": "sources.scoring.point.1",
      "text": "Each dimension receives a score from 0–100 (the weighted average of answered items).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "92a7207df58fac7453e571870efe2e21f43d6cd90fdba0740d6f352736b0b1b1"
    },
    {
      "id": "sources.scoring.point.2",
      "text": "Optional short fitness tests complement the relevant fitness sub-area. The medically approved allocation is as follows: push-ups and wall sits together form the test half of the muscular fitness sub-area; the wall sit does not count towards cardiovascular endurance. The single-leg stance forms the test half of balance/mobility. A category is only shown when age, sex and test protocol match; from age 18, the wall-sit category is based on a harmonised training guide and is not a clinical norm.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "0080c8de0852f912011477dc573da2aa4e5540f811b66d647515b0ecda0c0853"
    },
    {
      "id": "sources.scoring.point.3",
      "text": "Status levels: 80–100 Strong, 60–79 Solid foundation, 40–59 Room for improvement, 0–39 Needs attention.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "2bba7e25cec03bbbfeaa90956bb1eaf1b61da58b8d1f8692904ca3300437fae8"
    },
    {
      "id": "sources.scoring.point.4",
      "text": "Risk signals are separated into lifestyle potential and the need for medical assessment.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e13fa36378a229abf92fee82a3f0f2620d2c457a156a5eb6f863c907df8d5688"
    },
    {
      "id": "sources.scoring.point.5",
      "text": "Strengths, areas for action and the top 3 steps are derived from the same answer-based levers (including cross-dimensional risk patterns such as cardiovascular patterns); critical signals always take priority.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "1da67216dca62c31c9248266c2cfa85f4a6b6677e0196d9d8d79f3e9b505de90"
    },
    {
      "id": "sources.review_disclaimer",
      "text": "Before the product is used in practice, Helsana medical professionals should complete a final review and approval of the specialist content and reference values.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "c212cfcd5997f91e6232c5a7f799cccdb21c96f03cc23fab049a5af6d72070b2"
    }
  ]
}
