    {
      "id": "sources.strength.point.1",
      "text": "Muscle strength and physical function are important building blocks for resilience and independence.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "927e0074761fffb41f4b3ba38760c62dc471d852379f9127e09aeb886d95de9d"
    },
    {
      "id": "sources.strength.point.2",
      "text": "You can also start with bodyweight exercises.",
