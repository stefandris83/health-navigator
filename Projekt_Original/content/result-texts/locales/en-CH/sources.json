      "translationState": "translated",
      "sourceContractHash": "39ed3ce924371f45b07008110ac733b9445cfd86a982604d367b74148dd6a0e2"
    },
    {
      "id": "sources.sleep.point.2",
      "text": "Sleep hygiene: keep regular times, make the room cool/dark/quiet, and switch off screens around 30 minutes beforehand.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "640b291694851427aeba3284064ad7b945795ca3d0b167f62fd8d1e0ecf6dada"
    },
    {
      "id": "sources.sleep.point.3",
      "text": "Seek medical advice for persistent problems, snoring or pauses in breathing.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "552cb3658e2d92f22da5fe50d4511e01018461fe2eea72702f20da365459adf3"
