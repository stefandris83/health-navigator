    {
      "id": "sources.physical.title",
      "text": "Physical activity & physical performance",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "6c89231c0c8c65e9bbefb767ddea658d3e88fedb3e81fad338d7211ded015b97"
    },
    {
      "id": "sources.physical.reference",
      "text": "WHO – Physical activity · WHO Guidelines on physical activity and sedentary behaviour (2020)",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fb2995582913bda8b4006917530121573b82edfa80712a8e15ed4430f361b74e"
    },
    {
      "id": "sources.link.who",
      "text": "who.int",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "c6cbc4b950daef6426350154ad973d3b26869648a1789b4aec0340b58adf2a03"
    },
    {
      "id": "sources.separator",
      "text": "·",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a45fd340e015635d4cbb00c8a9fabb3e09c7d51452cc56230344d237e5e012fb"
    },
    {
      "id": "sources.physical.point.1",
      "text": "150–300 min/week of moderate-intensity or 75–150 min/week of vigorous-intensity aerobic activity.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "88db9ed813a3da89bb81eb7c6840e01292f2f0c900917d0ee84e121389cd982d"
    },
    {
      "id": "sources.physical.point.2",
      "text": "Muscle-strengthening activity on at least 2 days/week.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4b7006d07a0cb53b9b8d9dab80ef035ce05558311c20cf44db80eafb5ecd9528"
    },
    {
      "id": "sources.physical.point.3",
      "text": "Reduce sedentary time – every movement counts.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "c9292d54946bb1c684d8ed0ef48ad61fb7345f87b518da9aa545375506b9b2ad"
    },
    {
      "id": "sources.physical.point.4",
      "text": "Reduces the risk of cardiovascular disease, type 2 diabetes, some cancers and falls; improves mental health, sleep and body composition.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fcc4ed35e1d56096661b18b34cc309455bce36f93acaac25a44f6b15e93df6cd"
    },
    {
      "id": "sources.card.2.number",
      "text": "2",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "6ef8a3f5a26137b8bf44251586a8ca8b3c68c75efa8ad574a6a9e81f39db486b"
    },
    {
      "id": "sources.nutrition.title",
      "text": "Nutrition",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "2acb6cad29de9d78eaf79125b7076335c7e4653c7ded6f82fe759c52cc5ac248"
    },
    {
      "id": "sources.nutrition.reference.who",
      "text": "WHO – Healthy diet",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "ae3ea8592385e8fe9046e672808255eba2d0bb2263fe460f0106b9c64c2c6feb"
    },
    {
      "id": "sources.nutrition.reference.morton",
      "text": "Protein & strength training – Morton et al., meta-analysis",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "558c1ba50829980617d7bb93987d64f154294b6aad1ae112a3c2a96e5cdcb883"
    },
    {
      "id": "sources.link.pubmed",
      "text": "pubmed.ncbi.nlm.nih.gov",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "d8d8350d45aa797a37c91adec1986ba935680ff43e1488fc057ba3958af564c5"
    },
    {
      "id": "sources.nutrition.reference.issn",
      "text": "Protein & training – ISSN Position Stand",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "bd6f7b3e329f09d266b4606fbf7d33767503df97f1e3b25e52ee5abbcc00c72d"
    },
    {
      "id": "sources.link.jissn",
      "text": "jissn.biomedcentral.com",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "9bcbd433c102646043ae8cfc397947e7dfe1bc52ad4874cd9b09760ac0c088e8"
    },
    {
      "id": "sources.nutrition.reference.espen",
      "text": "Protein in older age – ESPEN Practical Guideline",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "67a03a3a4a57860fb1ad4258bc7fe3dd1d36ed5cceaed83a0da920d2bfbae313"
    },
    {
      "id": "sources.link.espen",
      "text": "espen.org",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "863f826de82bc85e9a6bca6ca2733c8731edec924f5d95e55709cc7e203a6421"
    },
    {
      "id": "sources.nutrition.point.1",
      "text": "At least 400 g of vegetables & fruit per day (around five portions).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "2d1d7a4764ed1e2f32d7047538e0695b74df290365e8fd6a80c625088fa49e68"
    },
    {
      "id": "sources.nutrition.point.2",
      "text": "At least 25 g of fibre per day (pulses, whole grains).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "7489d230b5481c096d3d22d17f9b74b1464065cb91f144c82329d8deb1493f80"
    },
    {
      "id": "sources.nutrition.point.3",
      "text": "Free sugars below 10% of total energy intake (~50 g), ideally below 5%.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e99c9102588913dff4e5a026884792fa1c0e93093213cf8223adcbb784148ce6"
    },
    {
      "id": "sources.nutrition.point.4",
      "text": "Salt below 5 g/day; saturated fats below 10% of total energy intake.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "d748b6515cb436d4a2bb28be74a14a31d9fac5150572eb308828f854deb1bf99"
    },
    {
      "id": "sources.nutrition.point.5",
      "text": "For healthy adults who strength-train regularly, 1.4–1.6 g of protein/kg/day is a practical guide; on average, additional benefits level off markedly at around 1.6 g/kg/day.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "85dd42d4b1da4bdaa8c44fc101528dc41024b7e596a806d449614c083fa9cf24"
    },
    {
      "id": "sources.nutrition.point.6",
      "text": "Up to around 2.0 g/kg/day is only a possible individual range during very high training loads or a planned energy deficit. It is not a general target and is not justified by age alone.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a6a99f17051aaa80d804060056d6440bd20f6c9f209a51070fe48204c701f0ca"
    },
    {
      "id": "sources.nutrition.point.7",
      "text": "The protein question measures how regularly protein sources are included, not the actual daily amount.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "7d29e0bf3608b485409a0b0e7a04af34ad09f552a5949387e02ad304654d44b0"
    },
    {
      "id": "sources.nutrition.point.8",
      "text": "Eat more plant-based and fewer highly processed foods.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5e63add512f10a22d92682a44653790206433ab4ef548b3c134e4d0f81eb4a3c"
    },
    {
      "id": "sources.card.3.number",
      "text": "3",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e465f888320e7d09357fd65f8ba92185956795746a9d3fb57d7d43be8d2e4047"
    },
    {
      "id": "sources.blood_pressure.title",
      "text": "Blood pressure & cardiovascular prevention",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5ce8d1a6bea11a8592c93ca3fb57cfaafd5e622dc2bbf8759e7bc93e69a0b94f"
    },
    {
      "id": "sources.blood_pressure.reference",
      "text": "WHO – Hypertension",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "4f17f4aca2d5987ad333cd22d01255e1b39b6176a5999f31c8a7d816b7f08883"
    },
    {
      "id": "sources.blood_pressure.point.1",
      "text": "Hypertension is defined as 140/90 mmHg or higher when measured on two different days.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e2d066f6957ad49dd6080b0afe1c0c154f2c1593d05df11db824f0184de324ac"
    },
    {
      "id": "sources.blood_pressure.point.2",
      "text": "Very high readings (~180/120 mmHg) → prompt medical assessment.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fc91aeb8844323a71e04f248aa8bcd511de071ed088a452d27dcc6576dd896dd"
    },
    {
      "id": "sources.blood_pressure.point.3",
      "text": "The target is often below 130/80 mmHg for people at higher risk, and otherwise below 140/90.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a42cae2b4d270ef4188d808325ba0505a7f3a20891267a22b9c0e1e2a62f103f"
    },
    {
      "id": "sources.blood_pressure.point.4",
      "text": "Lifestyle changes can lower blood pressure; alcohol: no more than 1 drink/day for women or 2 for men.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "f0898f65a1a64856e415b6460f593752c347a05645402129547051d8e675cb23"
    },
    {
      "id": "sources.card.4.number",
      "text": "4",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "eeee034973e1e377ce8a27228591a5c0efec7acc6047741b7795f5908e3cc83d"
    },
    {
      "id": "sources.lipids.title",
      "text": "Blood lipids, ApoB, LDL, non-HDL & Lp(a)",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "3cb907f81a09838567c9664de7d1755a50e7f035155f9322261c20dc055fe497"
    },
    {
      "id": "sources.lipids.reference",
      "text": "Consensus of medical professional societies (including ESC/EAS guidelines on dyslipidaemia) · Swiss Heart Foundation –",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "85b0580170c152625f6f8d8411b7834becbe2da4de969da0c3cb03012e3e23ee"
    },
    {
      "id": "sources.lipids.link_label",
      "text": "The values you need to know",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "f01ce6d539d89ed0c3890068938d714f478b4b24650e80f11d6c57cd5fc0cf65"
    },
    {
      "id": "sources.lipids.point.1",
      "text": "ApoB ≈ number of atherogenic particles; it often reflects risk more accurately than LDL alone.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "67c6f99567a89f79a8ad8ba8b407752ade8180fc2e85e2461f11adf01ecadfbb"
    },
    {
      "id": "sources.lipids.point.2",
      "text": "LDL cholesterol: a central factor in atherosclerosis; non-HDL is a simple combined measure.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "ebab5e3dbe23d15070411b4d11e6a37d74a5e81d4047958c80c6f6cb5d2aab93"
    },
    {
      "id": "sources.lipids.point.3",
      "text": "A desirable ApoB level is approximately below 90–100 mg/dL (broad guide).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "d8ccf167ce4e4fd54969501b32284bec5ed22c25e07a924bb2625a8e0e370421"
    },
    {
      "id": "sources.lipids.point.4",
      "text": "Lp(a) is genetically determined and usually measured once; elevated above 50 mg/dL or 125 nmol/L.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "8d158a60b8bb8545bcaf3155004dafadf1a83aed646398a704fd06be7087d197"
    },
    {
      "id": "sources.card.5.number",
      "text": "5",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e4d6fdc80858469e75210f13fabc703062ef19fd1b82bfcef16cd84418ac326e"
    },
    {
      "id": "sources.metabolic.title",
      "text": "Metabolic health, blood glucose & HbA1c",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "10f7635af427083d6757d5fde4144d6f7e9ad24bde01ac23138760331ae98d0c"
    },
    {
      "id": "sources.metabolic.reference",
      "text": "WHO/ADA criteria for (pre)diabetes",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "d129722f1e629c24eb4cfef1ed189aab2933ba838decba9b61b97f6c80223825"
    },
    {
      "id": "sources.metabolic.point.1",
      "text": "HbA1c: normal below 5.7%; prediabetes 5.7–6.4%; diabetes from 6.5%.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "e69b055710dde9d3be45a18afe3427379ecc10ad11cfe873a46318a3d7afd887"
    },
    {
      "id": "sources.metabolic.point.2",
      "text": "Fasting blood glucose: normal below 5.6; prediabetes 5.6–6.9; diabetes from 7.0 mmol/L.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "cda43d60cb3a569aaf76a2f97c78debba9fc8a6d4638fa3f317b2870ac6cfe9e"
    },
    {
      "id": "sources.metabolic.point.3",
      "text": "Triglycerides: normal below 1.7 mmol/L (below 150 mg/dL).",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "a420cbb8626e67abfbaf5f7ce92325d24944baebb820acff848d1b341d52d928"
    },
    {
      "id": "sources.metabolic.point.4",
      "text": "Prediabetes can often be reversed through physical activity, weight management and nutrition.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "010d6734f73a7ae22130ed6541820956d591f4e1ca780309609a229c21313277"
    },
    {
      "id": "sources.card.6.number",
      "text": "6",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "37b0f031be7ef497f3c378529a413f4cfd5d995bf534a0cb5bb4dff3fc669dde"
    },
    {
      "id": "sources.waist.title",
      "text": "Abdominal fat & waist circumference",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "fd8065f9842f61de374b21eaa1fe6671c10d3303c7c5858a120ce0535c657658"
    },
    {
      "id": "sources.waist.reference",
      "text": "WHO/IDF waist circumference thresholds ·",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "da9615b40429099fffafb3b5b51f3f7034cc1b15f40adef80004afbe84e83df2"
    },
    {
      "id": "sources.waist.link_who",
      "text": "WHO Expert Consultation",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5b67729001efbeb57e204528c44e62297e4b977b3b18c7b4051a3048fd06409f"
    },
    {
      "id": "sources.waist.link_nice",
      "text": "NICE NG246",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "1b1e08865c367f133692209b0e74ee909253f749c5ac5d292c51fe43397602fe"
    },
    {
      "id": "sources.waist.point.1",
      "text": "Normal range: men below 94 cm, women below 80 cm.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "5c1ea27d9c4a9429db40c91409fff1f7c4c6b98d86230d30176e6438b94e8816"
    },
    {
      "id": "sources.waist.point.2",
      "text": "Elevated reference range: men 94 to below 102 cm, women 80 to below 88 cm.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "567b1b38e5477c87123d00a922129e071515e8322cc7d1f2934ce92db19f6d31"
    },
    {
      "id": "sources.waist.point.3",
      "text": "Markedly elevated reference range: men 102 cm or above, women 88 cm or above.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "cd10bfeac5f82eeba28f6dbf3a48d3e0edb3e5d53a103790cf1b8cba70c3f3da"
    },
    {
      "id": "sources.waist.point.4",
      "text": "BMI and waist circumference are guides and complement each other.",
      "requiredTerms": [],
      "reviewStatus": "needs-review",
      "translationState": "translated",
      "sourceContractHash": "90dd37008d853a31572219b22547424d3c8a1cefbf626dfac2aa13f9d0b74ceb"
    },
    {
      "id": "sources.card.7.number",
